<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>
  <Targets>
    <Target>
      <TargetName>HBDC130-05EG-I_GPT</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <TargetOption>
        <TargetCommonOption>
          <Device>GD32F103RC</Device>
          <Vendor>GigaDevice</Vendor>
          <PackID>GigaDevice.GD32F10x_DFP.2.0.1</PackID>
          <Cpu>IRAM(0x20000000,0x0000C000) IROM(0x08000000,0x00040000) CPUTYPE(&quot;Cortex-M3&quot;) CLOCK(12000000) ELITTLE</Cpu>
          <OutputDirectory>..\object\</OutputDirectory>
          <OutputName>HBDC130-05EG-I_GPT</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateHexFile>1</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <BrowseInformation>1</BrowseInformation>
        </TargetCommonOption>
        <TargetArmAds>
          <Cads>
            <interw>1</interw>
            <Optim>1</Optim>
            <oTime>1</oTime>
            <SplitLS>1</SplitLS>
            <OneElfS>1</OneElfS>
            <Strict>0</Strict>
            <EnumInt>0</EnumInt>
            <PlainCh>0</PlainCh>
            <Ropi>0</Ropi>
            <Rwpi>0</Rwpi>
            <wLevel>2</wLevel>
            <uThumb>0</uThumb>
            <VariousControls>
              <MiscControls>--c99 --cpu Cortex-M3 -D__MICROLIB -DGD32F10X_HD -DUSE_STDPERIPH_DRIVER</MiscControls>
              <Define>GD32F10X_HD,USE_STDPERIPH_DRIVER</Define>
              <IncludePath>..\app;..\protocol;..\driver;..\..\SRYM-HBDC130-05EG-I_V1.0\sdk;..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\CMSIS;..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals;..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\inc</IncludePath>
            </VariousControls>
          </Cads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File><FileName>main.c</FileName><FileType>1</FileType><FilePath>..\app\main.c</FilePath></File>
            <File><FileName>power_ctrl.c</FileName><FileType>1</FileType><FilePath>..\app\power_ctrl.c</FilePath></File>
            <File><FileName>fault_manager.c</FileName><FileType>1</FileType><FilePath>..\app\fault_manager.c</FilePath></File>
            <File><FileName>sensor_manager.c</FileName><FileType>1</FileType><FilePath>..\app\sensor_manager.c</FilePath></File>
            <File><FileName>fru_manager.c</FileName><FileType>1</FileType><FilePath>..\app\fru_manager.c</FilePath></File>
            <File><FileName>sdr_manager.c</FileName><FileType>1</FileType><FilePath>..\app\sdr_manager.c</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>Protocol</GroupName>
          <Files>
            <File><FileName>ipmb_frame.c</FileName><FileType>1</FileType><FilePath>..\protocol\ipmb_frame.c</FilePath></File>
            <File><FileName>ipmi_dispatch.c</FileName><FileType>1</FileType><FilePath>..\protocol\ipmi_dispatch.c</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>SDK</GroupName>
          <Files>
            <File><FileName>startup_gd32f10x_hd.s</FileName><FileType>2</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\CMSIS\startup_gd32f10x_hd.s</FilePath></File>
            <File><FileName>system_gd32f10x.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\CMSIS\system_gd32f10x.c</FilePath></File>
            <File><FileName>gd32f10x_gpio.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_gpio.c</FilePath></File>
            <File><FileName>gd32f10x_rcc.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_rcc.c</FilePath></File>
            <File><FileName>gd32f10x_misc.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_misc.c</FilePath></File>
            <File><FileName>gd32f10x_i2c.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_i2c.c</FilePath></File>
            <File><FileName>gd32f10x_adc.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_adc.c</FilePath></File>
            <File><FileName>gd32f10x_dma.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_dma.c</FilePath></File>
            <File><FileName>gd32f10x_usart.c</FileName><FileType>1</FileType><FilePath>..\..\SRYM-HBDC130-05EG-I_V1.0\sdk\Peripherals\src\gd32f10x_usart.c</FilePath></File>
          </Files>
        </Group>
      </Groups>
    </Target>
  </Targets>
</Project>
